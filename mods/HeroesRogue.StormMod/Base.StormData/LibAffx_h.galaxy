// ============================================================
// Difficulty IDs
// ============================================================

const int libAffx_difficultyNormal = 1;
const int libAffx_difficultyHeroic = 2;
const int libAffx_difficultyMythic = 3;

// ============================================================
// Trigger IDs
// ============================================================

const int libAffx_triggerAffixAdded                  =   1;     // Runs immediately and at the start of every game
const int libAffx_triggerGameStart                   =   2;     // Runs one time at the start of the game, regardless of stack count
const int libAffx_triggerOncePerGame                 =   3;     // Runs immediately and at the start of every game. Can only run once per game
const int libAffx_triggerOneTime                     =   4;     // Runs immediately. Does not run at the start of the game
const int libAffx_triggerNPCTakedown                 =   5;     // Runs on any NPC takedown
const int libAffx_triggerHeroTakedown                =   6;     // Runs on any Hero takedown
const int libAffx_triggerUnitCreated                 =   7;     // Runs when any unit is created
const int libAffx_triggerUnitDied                    =   8;     // Runs when any unit dies
const int libAffx_triggerUnitBehaviorChange          =   9;     // Runs when a unit receives specified behavior
const int libAffx_triggerUnitBehaviorCreate          =   10;    // 
const int libAffx_triggerUnitBehaviorChangeCategory  =   11;    // Runs when a unit receives behavior with the specified category
const int libAffx_triggerUnitChangeOwner             =   12;    // Runs when a unit changes ownership
const int libAffx_triggerPlayerEffectUsed            =   13;    // Runs when any player triggers the specified effect
const int libAffx_triggerHeroLevelUp                 =   14;    // Runs immediately once and on Hero level up
const int libAffx_triggerHeroRespawn                 =   15;    // Runs when Hero respawns
const int libAffx_triggerHeroKilled                  =   16;    // Runs when a Hero is killed
const int libAffx_triggerHeroGainTalent              =   17;    // Runs when a Hero gains a Talent
const int libAffx_triggerScaling                     =   18;    // Same as libAffx_triggerHeroLevelUp but also runs regardless of stack count
const int libAffx_triggerQuest                       =   19;    // Runs immediately if affix quest is NOT complete
const int libAffx_triggerPeriodic                    =   20;    // Runs periodically. Default: 0.0625s
const int libAffx_triggerWin                         =   21;    // Executes when enemy core dies.
const int libAffx_triggerAnyAffixAdded               =   22;    // Executes when ANY affix is added that has an affix added trigger.
const int libAffx_triggerExecute                     =   23;    // Obsolete, converts into libAffx_triggerAffixAdded

// ============================================================
// Catalog Modification IDs
// ============================================================

const int libAffx_catalogTypeFlat                        =   1;     // Base value
const int libAffx_catalogTypePerStack                    =   2;     // Value * total stacks
const int libAffx_catalogTypePerStackDelta               =   3;     // Value * added stacks
const int libAffx_catalogTypePerStackDeltaExclFirst      =   4;     // Value * added stacks (excluding first stack)
const int libAffx_catalogTypeBase                        =   5;     // Catalog base value (operation) value * total stacks
const int libAffx_catalogTypeBaseDelta                   =   6;     // Catalog base value (operation) value * added stacks
const int libAffx_catalogTypeBaseMult                    =   7;     // Catalog base value (operation) 1 + (value * total stacks)

// ============================================================
// Bank / Events
// ============================================================

const string libAffx_BankSection = "Affix Data";
const string libAffx_BankSectionSettings = "Heroes Rogue Settings";

const string libAffx_eventAffixAddedID = "EventAffix";
const string libAffx_eventAffixAddedParam = "AffixAdded";
const string libAffx_eventAffixAddedParam2 = "AmountAdded";

// ============================================================
// Config
// ============================================================

const int libAffx_rerollsStart = 3;
const int libAffx_rerollsPerGame = 1; 
const int libAffx_bansStart = 3; 
const int libAffx_bansPerGame = 1; 

const fixed libAffx_gameStartDelay = 2.25; // Wait for Heroes to finish spawning in
const fixed libAffx_disableHotkeysDuration = 0.25; // How long hotkeys such as picking affixes are disableed for
const fixed libAffx_disableDialogControlDuration = 0.25; // How long dialog controls such as picking/banning affixes buttons are disabled for

bool libAffx_appendTooltipInSelection = true; // Whether tooltips have extra information in the affix selection UI

// ============================================================
// Structs
// ============================================================

struct libAffx_Filter {
    unitfilter unitFilter;
    int requiredPlayer;
    string[libAffx_maxFilters + 1] requiredUnitTypes;
    int requiredUnitTypeIndex;
    string[libAffx_maxFilters + 1] excludedUnitTypes;
    int excludedUnitTypeIndex;
};

struct libAffx_CatalogModification {
    int player;
    int type;
    int operation;
    string reference;
    fixed value;
};

struct libAffx_Behavior {
    int player;
    string behavior;
    bool affectedByCount; // Whether behavior stacks scales with affix stacks.
    bool disallowManaUsers;
    bool onlyManaUsers;
};

struct libAffx_Trigger {
    int type;
    string name;
    string arg1;
    bool init;
    bool hasExecuted;
};

struct libAffx_Quest {
    bool isQuest;
    bool questDone;
    bool questProgressPersists;
    int questProgress;
    string tokenBehavior;
    fixed retainModifier;
    fixed tokenCount;
};

struct libAffx_QueuedAffix {
    int overrideAffix;
    int rarity;
    bool curse;
    int level;
    bool lockRarity;
    int choiceCount;
    bool rerollDisabled;
};

struct libAffx_AffixData {
    string name;
    string icon;

    int count; // Current number of stacks of the affix.
    int max; // Maximum amount allowed. 0 = Infinite

    int rarity;
    int weight; // Weight used for rolling affixes. Higher number = More likely.

    int minLevel; // Minimum level requirement. 0 = No requirement
    int maxLevel; // Maximum level requirement. 0 = No requirement

    bool curse;
    int skipCurses;

    bool enabled;
    bool shouldExecute;

    bool cannotRoll;
    bool banned;

    int[libAffx_maxRequirements + 1] excludedAffixes; // List of mutually exclusive affixes.
    int[libAffx_maxRequirements + 1] requiredAffixes; // List of required affixes.
    int excludedCount;
    int requiredCount;
    bool requiresMaxStacks; // If required affixes also require maximum stacks.
    
    bool[libAffx_maxMaps + 1] allowedMap; // List of Map requirements
    bool[libAffx_maxHeroes + 1] allowedHero; // List of Hero requirements.
    bool heroExclusive;
    bool[libAffx_maxHeroes + 1] customTooltipForHero; 
    bool customTooltipForNonManaUsers;

    int minDifficulty;
    int minRound;

    string[libAffx_maxTalents + 1] addTalents;
    string[libAffx_maxTalents + 1] showTalents;
    string[libAffx_maxTalents + 1] disableTalents;
    string[libAffx_maxTalents + 1] requiredTalents;
    int requiredTalentsCount;
    bool talentsApplied;

    libAffx_CatalogModification[libAffx_maxCatalogModifications + 1] catalogModifications;
    libAffx_Behavior[libAffx_maxBehaviors + 1] behaviors;
    libAffx_Behavior[libAffx_maxBehaviors + 1] affixBehaviors;
    libAffx_Behavior[libAffx_maxBehaviors + 1] removeBehaviors;
    libAffx_Trigger[libAffx_maxTriggers + 1] triggers;
    trigger[libAffx_maxTriggers + 1] createdTriggers;

    libAffx_Quest quest;
    libAffx_Quest[libAffx_maxQuests + 1] questRetain;

    string cooldownLink;
    fixed cooldown;
    bool cooldownHidden;

    fixed customValue;
    bool customBool;

    int lastSeen;

    bool excludeChoGall;
};

// ============================================================
// Filters
// ============================================================

unitfilter libAffx_filtersTeamOrder = UnitFilter(0, 0, (1 << c_targetFilterNeutral) | (1 << c_targetFilterEnemy) | (1 << c_targetFilterCreep) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))); // Filter for all units in team Order.
unitfilter libAffx_filtersTeamOrderNoStructures = UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterEnemy) | (1 << c_targetFilterCreep) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))); // Filter for all units in team Order excluding Structures.

libAffx_Filter libAffx_filterAllAllies;
libAffx_Filter libAffx_filterAlliedHeroes;
libAffx_Filter libAffx_filterAlliedStructures;
libAffx_Filter libAffx_filterAlliedStructuresExcludingCore;
libAffx_Filter libAffx_filterAlliedCore;
libAffx_Filter libAffx_filterAlliedMinions;

libAffx_Filter libAffx_filterAllEnemies;
libAffx_Filter libAffx_filterEnemyHeroes;
libAffx_Filter libAffx_filterEnemyStructures;
libAffx_Filter libAffx_filterEnemyStructuresExcludingCore;
libAffx_Filter libAffx_filterEnemyCore;
libAffx_Filter libAffx_filterEnemyMinions;
libAffx_Filter libAffx_filterDifficulty;

