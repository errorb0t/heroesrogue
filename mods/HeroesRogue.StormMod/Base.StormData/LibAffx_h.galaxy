// ============================================================
// Heroes Rogue
// ============================================================

const string libAffx_version = "0.15.5";

const int libAffx_player = 1; // Player ID
const int libAffx_enemy = 6; // First enemy player ID

const int libAffx_teamOrder = libCore_gv_cOMPUTER_TeamOrder;
const int libAffx_teamChaos = libCore_gv_cOMPUTER_TeamChaos;
const int libAffx_teamOrderIndex = libGame_gv_teamOrderIndex_C;
const int libAffx_teamChaosIndex = libGame_gv_teamChaosIndex_C;

const int libAffx_maxHeroes = 90;
const int libAffx_maxMaps = 7;
const int libAffx_maxTalents = 20;
const int libAffx_maxCatalogModifications = 20;
const int libAffx_maxBehaviors = 10;
const int libAffx_maxAffixBehaviors = 1000;
const int libAffx_maxTriggers = 10;
const int libAffx_maxQuests = 10;
const int libAffx_maxFilters = 100;
const int libAffx_maxAffixes = 400;
const int libAffx_maxQueue = 100;
const int libAffx_maxRequirements = 100;
