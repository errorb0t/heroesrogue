include "AffixTriggers"

int libAffx_PylonExpansionAmount;
int libAffx_ProbiusZealotCost = 5;
int libAffx_ProbiusStalkerCost = 10;
int libAffx_ProbiusImmortalCost = 30;

// ---------------------------------------------------------------
// Warp Technology
// ---------------------------------------------------------------
bool libAffx_ProbiusWarpTechnologyScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_LevelUpScaling("Effect,PsiBlades,Amount", player);
    libAffx_LevelUpScaling("Effect,ParticleDisruptorsU,Amount", player);
    libAffx_LevelUpScaling("Effect,PhaseDisruptors,Amount", player);
    libAffx_LevelUpScaling("Behavior,ImmortalHardenedShield,DamageResponse.ClampMaximum", player);
    libAffx_LevelUpScaling("Behavior,ImmortalHardenedShield,DamageResponse.Minimum", player);
    libAffx_LevelUpScaling("Unit,ProbiusZealot,LifeStart", player);
    libAffx_LevelUpScaling("Unit,ProbiusZealot,LifeMax", player);
    libAffx_LevelUpScaling("Unit,ProbiusZealot,ShieldsStart", player);
    libAffx_LevelUpScaling("Unit,ProbiusZealot,ShieldsMax", player);
    libAffx_LevelUpScaling("Unit,ProbiusZealot,ShieldRegenRate", player);
    libAffx_LevelUpScaling("Unit,ProbiusStalker,LifeStart", player);
    libAffx_LevelUpScaling("Unit,ProbiusStalker,LifeMax", player);
    libAffx_LevelUpScaling("Unit,ProbiusStalker,ShieldsStart", player);
    libAffx_LevelUpScaling("Unit,ProbiusStalker,ShieldsMax", player);
    libAffx_LevelUpScaling("Unit,ProbiusStalker,ShieldRegenRate", player);
    libAffx_LevelUpScaling("Unit,ProbiusImmortal,LifeStart", player);
    libAffx_LevelUpScaling("Unit,ProbiusImmortal,LifeMax", player);
    libAffx_LevelUpScaling("Unit,ProbiusImmortal,ShieldsStart", player);
    libAffx_LevelUpScaling("Unit,ProbiusImmortal,ShieldsMax", player);
    libAffx_LevelUpScaling("Unit,ProbiusImmortal,ShieldRegenRate", player);

    return true;
}
// ---------------------------------------------------------------
// Cannon Rush
// ---------------------------------------------------------------
bool libAffx_ProbiusCannonRushUnitCreated (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int owner = UnitGetOwner(createdUnit);
    if (testConds) {
        if (UnitGetType(createdUnit) != "ProbiusPhotonCannon") {
            return false;
        }
        if (owner != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    UnitBehaviorAdd(createdUnit, "ProbiusPhotonCannonExtenderBehavior", createdUnit, 1);
    return true;
}
// ---------------------------------------------------------------
// Optimized Ordnance
// ---------------------------------------------------------------
bool libAffx_ProbiusOptimizedOrdnance (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int owner = UnitGetOwner(createdUnit);
    if (testConds) {
        if (UnitGetType(createdUnit) != "ProbiusPhotonCannon") {
            return false;
        }
        if (owner != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    UnitBehaviorAdd(createdUnit, "ProbiusOptimizedOrdnanceAttackSpeedBehavior", createdUnit, 1);
    return true;
}
// ---------------------------------------------------------------
// Plasma Shields
// ---------------------------------------------------------------
bool libAffx_ProbiusPlasmaShields (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int owner = UnitGetOwner(createdUnit);
    if (testConds) {
        if (UnitGetType(createdUnit) != "ProbiusPhotonCannon" && UnitGetType(createdUnit) != "ProbiusPylon") {
            return false;
        }
        if (owner != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    UnitBehaviorAdd(createdUnit, "ProbiusPlasmaShieldsBehavior", createdUnit, 8);
    UnitBehaviorAdd(createdUnit, "ProbiusPlasmaShieldsController", createdUnit, 1);
    return true;
}
// ---------------------------------------------------------------
// Pylon Expansion
// ---------------------------------------------------------------
bool libAffx_ProbiusPylonExpansionAffixAdded (bool testConds, bool runActions) {
    int amount = libAffx_EventAffixCountAdded();
    if (!runActions) {
        return true;
    }
    libAffx_PylonExpansionAmount += amount;
    libHPRO_gv_heroProbiusWarpInPylonMaxNumberofPylons += amount;
    libHPRO_gv_heroProbiusWarpInPylonConstructAdditionalPylonsMaxNumberofPylons += amount;
    return true;
}
// ---------------------------------------------------------------
// Efficient Warp
// ---------------------------------------------------------------
bool libAffx_ProbiusEfficientWarpAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_ProbiusZealotCost -= 1;
    libAffx_ProbiusStalkerCost -= 2;
    libAffx_ProbiusImmortalCost -= 6;
    return true;
}
